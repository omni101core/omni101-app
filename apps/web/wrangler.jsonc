{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "omni101-app",
  "main": "workers/app.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "PUBLIC_ORIGIN": "https://omni101.app",
    "ORGANIZATION_ID": "omni101",
    "ACCESS_MFA_ENFORCED": "false",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFgSJI1-u08SQOIh"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "omni101-app",
      "database_id": "1887a135-05be-4b2e-a764-8ab5b3018a00",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "account_id": "179e35741ac5e7a9e2c3be26f5a482b8",
  "env": {
    "staging": {
      "name": "omni101-app-staging",
      "vars": {
        "PUBLIC_ORIGIN": "https://omni101-app-staging.omni101-core.workers.dev",
        "ORGANIZATION_ID": "omni101",
        "TURNSTILE_SITE_KEY": "0x4AAAAAAFgSJI1-u08SQOIh"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "omni101-app-staging",
          "database_id": "28dfa732-5f93-4b10-8c7d-542d8ccdb9e1",
          "migrations_dir": "../../packages/db/migrations"
        }
      ]
    }
  }
}
